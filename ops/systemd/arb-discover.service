[Unit]
Description=arbv2 Token Discovery (CMC + Factory)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_UNIX_USER
WorkingDirectory=/opt/arbv2
ExecStart=/opt/arbv2/target/release/arb-discover BSC Base
EnvironmentFile=/opt/arbv2/.env
Restart=always
RestartSec=30
StandardOutput=journal
StandardError=journal
Environment=RUST_LOG=info
Environment=RUST_BACKTRACE=1

[Install]
WantedBy=multi-user.target
