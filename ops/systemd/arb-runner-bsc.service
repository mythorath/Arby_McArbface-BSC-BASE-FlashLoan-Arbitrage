[Unit]
Description=arbv2 BSC Scanner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_UNIX_USER
WorkingDirectory=/opt/arbv2
ExecStart=/opt/arbv2/target/release/arb-runner config/bsc.toml
EnvironmentFile=/opt/arbv2/.env
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
Environment=RUST_LOG=info
Environment=RUST_BACKTRACE=1

[Install]
WantedBy=multi-user.target
