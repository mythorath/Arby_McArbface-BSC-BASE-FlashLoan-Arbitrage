# =============================================================================
# arbv2 — environment template
# Copy to `.env` and fill in YOUR values. Never commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# Wallet — the EOA that signs flash-loan-arb txs.
# Format: 64 hex chars, NO 0x prefix.
# Fund this with ~$10 of native gas token per chain (BNB on BSC, ETH on Base).
# All trading capital comes from the flash loan, NOT this wallet.
# -----------------------------------------------------------------------------
PRIVATE_KEY=your_64_char_hex_private_key_no_0x_prefix

# =============================================================================
# BSC (chain_id=56)
# =============================================================================

# Read endpoint — any reliable BSC RPC works. Chainstack Growth recommended.
# This is hit ~once per block for state refresh, mempool stream, etc.
BSC_RPC_URL=https://bsc-mainnet.example.com/YOUR_KEY
BSC_WSS_URL=wss://bsc-mainnet.example.com/YOUR_KEY

# Submission endpoint — used ONLY for `eth_sendRawTransaction` when a
# candidate's projected profit clears `submission.warp_threshold_usd`.
# Chainstack Trader (Warp) is billed per-call, so it's gated by profit size.
# Leave empty if you want to skip the paid tier and rely on free builders only.
BSC_TRADER_NODE=

# Deployed flash-loan arbitrage contract on BSC.
# This repo's deployment is at: 0x4C981b9E7563280E476e73005AecD67b84C38f69
# Deploy your own with `forge script script/DeployBsc.s.sol --broadcast`.
BSC_ARB_CONTRACT=

# StateReader helper contract — batches all pool slot0/getReserves reads
# into a single eth_call. This repo's deployment: 0xFDc74A7908EB700eFf0C89a0650998EB1cD6Cb4D
# Deploy your own with `forge script script/DeployBscStateReader.s.sol --broadcast`.
BSC_STATE_READER=

# =============================================================================
# Base (chain_id=8453)
# =============================================================================

BASE_RPC_URL=https://base-mainnet.example.com/YOUR_KEY
BASE_WSS_URL=wss://base-mainnet.example.com/YOUR_KEY

# Base does not currently have Warp-routed Chainstack endpoints; this is a
# regular Trader node used for tx submission throughput. Leave empty to skip.
BASE_TRADER_NODE=

# This repo's Base deployment: 0x32A299eEc5d08104dA69d2b4E6a02bea729aB9FB
BASE_ARB_CONTRACT=
# This repo's Base StateReader: 0x01e2ae89533A816060B4776a5c520fa26b9D9028
BASE_STATE_READER=

# =============================================================================
# MEV submission venues
# =============================================================================

# Blink (formerly Merkle) — free private mempool that forwards to all major
# builders on both BSC and Base. Sign up at https://blinklabs.xyz/ for an API
# key, paste the FULL URL including the key path here.
# Leave empty to skip Blink entirely.
BLINK_BSC_URL=
BLINK_BASE_URL=

# Direct-to-builder BSC submitters (free, no signup required).
# These are baked into config/bsc.toml; nothing to do here.

# =============================================================================
# CoinMarketCap API (Hobbyist plan, $29/mo, 150k credits)
# Used by arb-discover for memecoin/long-tail token discovery.
# Get your key at https://pro.coinmarketcap.com/
# =============================================================================
CMC_API_KEY=

# =============================================================================
# Block explorer keys (optional — only needed for `forge verify-contract`)
# =============================================================================
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=
